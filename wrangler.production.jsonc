{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "board-game-helper",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "cache": { "enabled": true },
  "triggers": { "crons": ["0 16 * * SUN"] },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "board-game-rules-prod",
      "database_id": "899e7766-1ac5-409c-8198-362f441d0e95",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://board-game-helper.louieddxu2.workers.dev",
    "TRUSTED_APP_ORIGINS": "",
    "GOOGLE_CLIENT_ID": "646550209695-k8rpmd24gsndqo41bdo7mqcu1ftrcpjb.apps.googleusercontent.com",
    "BOOTSTRAP_ADMIN_EMAIL": "louieddxu2@gmail.com"
  }
}
